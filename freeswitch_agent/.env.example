# === Server ===
# Host/port cho FastAPI server (mặc định: 0.0.0.0:8086)
HOST=0.0.0.0
PORT=8086

# === Ollama (tùy chọn - có giá trị mặc định) ===
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama3.2:latest

# === Whisper (tùy chọn) ===
# WHISPER_DEVICE=cpu    # Đổi thành "cuda" nếu có GPU NVIDIA

# === Piper ===
# Thư mục chứa voice model (mặc định: /opt/ollama-playground/local-voice-agent/voices)
# PIPER_VOICES_DIR=/opt/ollama-playground/local-voice-agent/voices

# === Pipeline ===
# IDLE_TIMEOUT_SECS=300  # Thời gian chờ tối đa trước khi tự động ngắt

# === Logging ===
# LOG_LEVEL=info  # debug, info, warning, error

# === Development ===
# UVICORN_RELOAD=true  # Tự động reload khi code thay đổi

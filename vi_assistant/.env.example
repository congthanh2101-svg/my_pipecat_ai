# === Daily.co (bắt buộc cho WebRTC transport) ===
# Đăng ký tại https://dashboard.daily.co/ để lấy API Key
DAILY_API_KEY=your_daily_api_key_here

# === Daily Room (tùy chọn - dùng room có sẵn thay vì tạo mới) ===
# DAILY_ROOM_URL=https://your-domain.daily.co/room-name

# === Ollama (tùy chọn - có giá trị mặc định) ===
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama3.2:latest

# === Whisper (tùy chọn) ===
# WHISPER_DEVICE=cpu    # Đổi thành "cuda" nếu có GPU NVIDIA
